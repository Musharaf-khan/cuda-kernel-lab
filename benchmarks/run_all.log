=================== Build (ARCH=sm_75)
mkdir -p build
nvcc -O3 -arch=sm_75 -lineinfo -std=c++17 kernels/01_vecadd/vecadd_bench.cu -o build/vecadd_bench
nvcc -O3 -arch=sm_75 -lineinfo -std=c++17 kernels/02_reduction/reduction.cu -o build/reduction
nvcc -O3 -arch=sm_75 -lineinfo -std=c++17 kernels/03_transpose/transpose.cu -o build/transpose
nvcc -O3 -arch=sm_75 -lineinfo -std=c++17 kernels/04_gemm/gemm.cu -o build/gemm -lcublas
nvcc -O3 -arch=sm_75 -lineinfo -std=c++17 kernels/04_gemm/gemm_lab.cu -o build/gemm_lab -lcublas
nvcc -O3 -arch=sm_75 -lineinfo -std=c++17 kernels/05_softmax/softmax.cu -o build/softmax
nvcc -O3 -arch=sm_75 -lineinfo -std=c++17 kernels/06_layernorm/layernorm.cu -o build/layernorm
nvcc -O3 -arch=sm_75 -lineinfo -std=c++17 kernels/07_attention/attention.cu -o build/attention -lcublas
nvcc -O3 -arch=sm_75 -lineinfo -std=c++17 kernels/08_hgemm_wmma/hgemm.cu -o build/hgemm -lcublas

